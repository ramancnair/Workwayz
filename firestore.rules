rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow any logged-in user to read and write to the database.
    // Note: For production, you should restrict this to specific collections
    // and validate data according to your schema.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
