# ==============================================================================
# ProjectFlow - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Or pass these environment variables to Docker / your cloud hosting provider.
#
# NOTE: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Sensitive server-only keys (GEMINI_API_KEY, SERVICE_ROLE_KEY) MUST NOT have
# the NEXT_PUBLIC_ prefix.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & AUTHENTICATION PROVIDER
# ------------------------------------------------------------------------------
# Choose your active database and authentication provider:
# Options: 'supabase' | 'firebase'
NEXT_PUBLIC_DB_PROVIDER=supabase
NEXT_PUBLIC_AUTH_PROVIDER=supabase

# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION (Choose Cloud or Local Docker)
# ------------------------------------------------------------------------------
# Option 2A: Supabase Cloud (Managed)
# Find these in your Supabase Project Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Option 2B: Supabase Docker / Local (Self-Hosted)
# If running Supabase locally via Docker, use your local gateway:
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# (Optional) Server-side Service Role Key for administrative setup tasks:
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. FIREBASE CONFIGURATION (Alternative Provider)
# ------------------------------------------------------------------------------
# If NEXT_PUBLIC_DB_PROVIDER=firebase, fill in your Firebase Web App credentials:
# Find these in Firebase Console -> Project Settings -> General -> Your Apps
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# ------------------------------------------------------------------------------
# 4. AI & FLOWPILOT COPILOT CONFIGURATION
# ------------------------------------------------------------------------------
# Active AI provider: 'google' | 'lmstudio' | 'openai' | 'anthropic' | 'ollama'
NEXT_PUBLIC_AI_PROVIDER=google

# Google Gemini API Key (Recommended default - https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key

# (Optional) Alternative AI Providers:
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# (Optional) Local LLM endpoint (LM Studio / Ollama):
# LOCAL_AI_BASE_URL=http://localhost:1234/v1
# AI_DEFAULT_MODEL=gemini-2.5-flash

# (Optional) Rate utilization limits:
AI_RPM_LIMIT=15
AI_TPM_LIMIT=1000000

# ------------------------------------------------------------------------------
# 5. SYSTEM & LOGGING CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=production

# (Optional) GitHub Issue Reporter integration
# GITHUB_TOKEN=your-github-personal-access-token
# GITHUB_REPO_OWNER=your-org-or-username
# GITHUB_REPO_NAME=ProjectFlow
